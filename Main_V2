  // Decode a Base32-encoded TOTP secret.
  function base32Decode(encoded) {
    const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';

    encoded = (encoded || '')
      .replace(/[=\s]/g, '')
      .toUpperCase();

    let bits = '';

    for (const character of encoded) {
      const value = ALPHABET.indexOf(character);

      if (value === -1) {
        throw new Error('Invalid Base32 character: ' + character);
      }

      bits += value.toString(2).padStart(5, '0');
    }

    const bytes = new Uint8Array(Math.floor(bits.length / 8));

    for (let i = 0; i < bytes.length; i++) {
      bytes[i] = parseInt(
        bits.slice(i * 8, i * 8 + 8),
        2
      );
    }

    return bytes;
  }


  // Generate a time-based one-time password.
  async function generateTOTP(secret, timeStepSeconds = 30, digits = 6) {
    if (!secret) {
      return {
        otp: 'SET KEY',
        remaining: 0,
        error: 'TOTP secret is not configured'
      };
    }

    try {
      const keyBytes = base32Decode(secret);

      const epoch = Math.floor(Date.now() / 1000);
      const counter = Math.floor(epoch / timeStepSeconds);

      const counterBuf = new ArrayBuffer(8);
      const view = new DataView(counterBuf);

      view.setUint32(4, counter, false);
      view.setUint32(
        0,
        Math.floor(counter / 0x100000000),
        false
      );

      const cryptoKey = await window.crypto.subtle.importKey(
        'raw',
        keyBytes,
        {
          name: 'HMAC',
          hash: 'SHA-1'
        },
        false,
        ['sign']
      );

      const signature = await window.crypto.subtle.sign(
        'HMAC',
        cryptoKey,
        counterBuf
      );

      const hmac = new Uint8Array(signature);

      const offset = hmac[hmac.length - 1] & 0x0f;

      const code =
        ((hmac[offset] & 0x7f) << 24) |
        ((hmac[offset + 1] & 0xff) << 16) |
        ((hmac[offset + 2] & 0xff) << 8) |
        (hmac[offset + 3] & 0xff);

      const otp = (code % Math.pow(10, digits))
        .toString()
        .padStart(digits, '0');

      const remaining =
        timeStepSeconds - (epoch % timeStepSeconds);

      return {
        otp,
        remaining
      };

    } catch (err) {
      return {
        otp: '------',
        remaining: 0,
        error: err.message
      };
    }
  }


  // Wait for a fresh OTP instead of reusing an expired one.
  async function ensureFreshTOTP() {
    while (!stopRequested) {
      const { otp, remaining } = await generateTOTP(totpSecret);

      if (otp !== lastUsedOtp && remaining >= 2) {
        return otp;
      }

      const waitSec =
        otp === lastUsedOtp ? remaining : remaining + 1;

      say(`⏳ Waiting ${waitSec}s for fresh TOTP code...`);

      await sleep(500);
    }

    return null;
  }


  // ============================================================
  // 03. DOM & REACT HELPERS
  // ============================================================

  // Update React-controlled input fields correctly.
  function setReactValue(el, value) {
    const setter =
      Object.getOwnPropertyDescriptor(
        HTMLInputElement.prototype,
        'value'
      )?.set ||
      Object.getOwnPropertyDescriptor(
        HTMLTextAreaElement.prototype,
        'value'
      )?.set;

    if (setter) {
      setter.call(el, value);
    } else {
      el.value = value;
    }

    el.dispatchEvent(
      new Event('input', { bubbles: true })
    );

    el.dispatchEvent(
      new Event('change', { bubbles: true })
    );
  }


  // Detect the currently open Unit and Session.
  function currentSession() {
    const text = [...document.querySelectorAll(
      '.ant-card-head-title, .userPageHeader, h3, h4'
    )]
      .map((el) => el.textContent || '')
      .find((value) =>
        /Learning Unit/i.test(value) ||
        (
          /Unit\s*:\s*\d+/i.test(value) &&
          /Session\s*:\s*(\d+)/i.test(value)
        )
      );

    const match = text && text.match(
      /Unit\s*:\s*(\d+)\s*&?\s*Session\s*:\s*(\d+)/i
    );

    return match
      ? {
          unit: +match[1],
          session: +match[2]
        }
      : null;
  }


  // Identify the SLO number associated with an input.
  function sloOf(input) {
    let tr = input.closest('tr');

    while (tr) {
      const th = tr.querySelector(
        ':scope > th, :scope > td:first-child'
      );

      const match = th &&
        th.textContent.match(/SLO\s*(\d+)/i);

      if (match) {
        return +match[1];
      }

      tr = tr.parentElement &&
        tr.parentElement.closest('tr');
    }

    const id = input.id.match(/\d+/);

    return id ? +id[0] : null;
  }


  // Trigger a click sequence on an element.
  function realClick(el) {
    if (!el) return;

    el.click();

    ['mousedown', 'mouseup', 'click'].forEach((type) => {
      el.dispatchEvent(
        new MouseEvent(type, {
          bubbles: true,
          cancelable: true,
          buttons: 1
        })
      );
    });
  }


  // ============================================================
  // 04. LEARNING PRACTICE PANEL DETECTION
  // ============================================================

  // Expand Learning Practice panels and wait for their inputs.
  async function waitForAndExpandInputs(
    expectedCount = 2,
    timeoutMs = 4500
  ) {
    const start = Date.now();

    say('📂 Expanding Learning Practice panels...');

    while (Date.now() - start < timeoutMs) {
      if (stopRequested) return [];

      const practiceHeaders = [
        ...document.querySelectorAll('.ant-collapse-header')
      ].filter((header) =>
        /Learning\s*Practice/i.test(header.textContent || '')
      );

      for (const header of practiceHeaders) {
        const item = header.closest('.ant-collapse-item');

        const isExpanded =
          header.getAttribute('aria-expanded') === 'true' ||
          (
            item &&
            item.classList.contains('ant-collapse-item-active')
          );

        if (!isExpanded) {
          realClick(header);

          const titleSpan = header.querySelector(
            '.ant-collapse-title'
          );

          if (titleSpan) {
            realClick(titleSpan);
          }

          await sleep(100);
        }
      }

      await sleep(150);

      const inputs = [
        ...document.querySelectorAll(INPUT_SEL)
      ];

      if (inputs.length >= expectedCount) {
        return inputs;
      }

      if (
        inputs.length > 0 &&
        practiceHeaders.length > 0 &&
        inputs.length >= practiceHeaders.length
      ) {
        return inputs;
      }
    }

    return [
      ...document.querySelectorAll(INPUT_SEL)
    ];
  }


  // ============================================================
  // 05. STORED LINK MANAGEMENT
  // ============================================================

  // Check whether a session has at least one stored link.
  function hasStoredLinksForSession(unit, session) {
    const link1 = (
      GM_getValue(key(unit, session, 1), '') || ''
    ).trim();

    const link2 = (
      GM_getValue(key(unit, session, 2), '') || ''
    ).trim();

    return isDrive(link1) || isDrive(link2);
  }


  // Find the next session with stored links.
  // Search current unit first, then later units if enabled.
  function findNextTargetSession(
    curUnit,
    curSess,
    crossUnits = false
  ) {
    for (
      let session = curSess + 1;
      session <= SESSIONS;
      session++
    ) {
      if (hasStoredLinksForSession(curUnit, session)) {
        return {
          unit: curUnit,
          session
        };
      }
    }

    if (crossUnits) {
      for (
        let unit = curUnit + 1;
        unit <= 5;
        unit++
      ) {
        for (
          let session = 1;
          session <= SESSIONS;
          session++
        ) {
          if (hasStoredLinksForSession(unit, session)) {
            return {
              unit,
              session
            };
          }
        }
      }
    }

    return null;
  }


  // ============================================================
  // 06. SUNBURST WHEEL NAVIGATION
  // ============================================================

  // Trigger the wheel's native pointer/mouse events.
  // Supports DOM elements, D3 selections and jQuery-like wrappers.
  function clickSunburstArc(arcEl) {
    if (!arcEl) {
      throw new Error('Sunburst arc element not found.');
    }

    let el = arcEl;

    if (typeof el.node === 'function') {
      el = el.node();

    } else if (
      typeof el.get === 'function' &&
      !el.dispatchEvent
    ) {
      el = el.get(0);

    } else if (
      !el.dispatchEvent &&
      el[0] &&
      el[0].dispatchEvent
    ) {
      el = el[0];
    }

    if (!el || typeof el.dispatchEvent !== 'function') {
      throw new Error(
        'Sunburst target is not a DOM element. Check the wheel segment selector.'
      );
    }

    const rect = el.getBoundingClientRect();

    const clientX = rect.left + rect.width / 2;
    const clientY = rect.top + rect.height / 2;

    [
      'pointerdown',
      'mousedown',
      'pointerup',
      'mouseup',
      'click'
    ].forEach((type) => {
      const EventClass = type.startsWith('pointer')
        ? PointerEvent
        : MouseEvent;

      el.dispatchEvent(
        new EventClass(type, {
          bubbles: true,
          cancelable: true,
          composed: true,
          clientX,
          clientY,
          button: 0,
          buttons: type.endsWith('down') ? 1 : 0
        })
      );
    });

    // D3 event-handler fallback.
    try {
      const rawNode = el.wrappedJSObject || el;

      if (Array.isArray(rawNode.__on)) {
        const d3Click = rawNode.__on.find(
          (entry) => entry && entry.type === 'click'
        );

        if (
          d3Click &&
          typeof d3Click.value === 'function'
        ) {
          d3Click.value.call(
            rawNode,
            new MouseEvent('click', {
              bubbles: true,
              cancelable: true,
              clientX,
              clientY
            }),
            rawNode.__data__
          );
        }
      }

    } catch (err) {
      console.warn(
        '[SRM AutoFill] D3 click fallback:',
        err
      );
    }
  }


  // Navigate to a session by clicking its SLO 1 wheel segment.
  async function navigateToSessionViaWheel(
    targetU,
    targetS
  ) {
    const current = currentSession();

    if (
      current &&
      current.unit === targetU &&
      current.session === targetS
    ) {
      return true;
    }

    const slo1ArcId =
      `mainArc-${targetU * 1000 + targetS * 10 + 1}`;

    let arcEl = null;

    // Wait for lazy-loaded wheel segments.
    for (
      let i = 0;
      i < 25 && !stopRequested;
      i++
    ) {
      arcEl = document.getElementById(slo1ArcId);

      if (arcEl) break;

      await sleep(150);
    }

    if (!arcEl) {
      say(
        `⚠️ Wheel segment #${slo1ArcId} did not appear.`
      );

      return false;
    }

    arcEl.scrollIntoView({
      behavior: 'instant',
      block: 'center'
    });

    await sleep(80);

    say(`🎡 Opening Unit ${targetU} Session ${targetS}...`);

    clickSunburstArc(arcEl);

    // Confirm that the target session actually opened.
    for (let w = 0; w < 18; w++) {
      await sleep(150);

      const now = currentSession();

      if (
        now &&
        now.unit === targetU &&
        now.session === targetS
      ) {
        await sleep(350);
        return true;
      }
    }

    say(`⚠️ Session switch failed: U${targetU} S${targetS}.`);

    return false;
  }
      // ============================================================
  // 07. OTP VERIFICATION HANDLER
  // ============================================================

  async function waitForAndFillOTP(timeoutMs = 12000) {
    const start = Date.now();

    say('⏳ Waiting for OTP prompt...');

    while (Date.now() - start < timeoutMs) {
      if (stopRequested) return false;

      const otpInputs = [
        ...document.querySelectorAll(
          '.ant-otp-input, input.ant-otp-input, input[placeholder*="6-digit"], input[placeholder*="code"], input[placeholder*="OTP"]'
        )
      ];

      const activeModal = document.querySelector(
        '.ant-modal-content, .ant-modal, .otp-modal'
      );

      if (
        otpInputs.length > 0 ||
        (
          activeModal &&
          activeModal.textContent.includes('6-digit')
        )
      ) {
        say('🔑 OTP prompt detected...');

        await sleep(150);

        const otp = await ensureFreshTOTP();

        if (
          !otp ||
          otp === '------' ||
          otp === 'SET KEY'
        ) {
          say('⚠️ TOTP generation failed or was stopped.');
          return false;
        }

        say('🔑 Filling TOTP code...');

        // Handle six separate OTP input boxes.
        if (otpInputs.length === 6) {
          for (let i = 0; i < 6; i++) {
            setReactValue(otpInputs[i], otp[i]);
            await sleep(35);
          }

        // Handle one combined OTP input.
        } else if (otpInputs.length > 0) {
          setReactValue(otpInputs[0], otp);
        }

        // Dispatch a paste event as an additional compatibility step.
        if (otpInputs[0]) {
          try {
            const dt = new DataTransfer();

            dt.setData('text/plain', otp);

            otpInputs[0].dispatchEvent(
              new ClipboardEvent('paste', {
                bubbles: true,
                cancelable: true,
                clipboardData: dt
              })
            );

          } catch (_) {}
        }

        await sleep(200);

        const verifyBtn = [
          ...document.querySelectorAll('button, .ant-btn')
        ].find((button) =>
          /verify/i.test(button.textContent || '') &&
          !button.disabled &&
          button.offsetParent !== null
        );

        if (!verifyBtn) {
          say('⚠️ Verify button not found.');
          return false;
        }

        say('🚀 Clicking Verify...');
        verifyBtn.click();

        // Wait for the modal to close.
        const verifyStart = Date.now();

        while (Date.now() - verifyStart < 15000) {
          if (stopRequested) return false;

          const errEl = document.querySelector(
            '.ant-alert-error, .ant-message-error, .ant-form-item-explain-error'
          );

          if (
            errEl &&
            errEl.offsetParent !== null &&
            (errEl.textContent || '').trim()
          ) {
            say(
              '❌ OTP verification error: ' +
              (errEl.textContent || 'Failed').trim()
            );

            return false;
          }

          const stillOpen = document.querySelector(
            '.ant-modal-content, .ant-modal, .otp-modal'
          );

          if (!stillOpen || stillOpen.offsetParent === null) {
            lastUsedOtp = otp;
            say('✅ TOTP verified successfully!');
            return true;
          }

          await sleep(200);
        }

        say('⚠️ OTP modal did not close. Verification unconfirmed.');
        return false;
      }

      await sleep(200);
    }

    // No OTP prompt appeared. This is not automatically a failure.
    say('ℹ️ No OTP prompt detected.');
    return true;
  }


