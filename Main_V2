  // Find the table row that owns this SLO.
  function findSloRow(input) {
    let row = input?.closest('tr');

    while (row) {
      const firstCell = row.querySelector(
        ':scope > th, :scope > td:first-child'
      );

      if (
        firstCell &&
        /SLO\s*\d+/i.test(firstCell.textContent || '')
      ) {
        return row;
      }

      row = row.parentElement?.closest('tr') || null;
    }

    // Fallback for layouts that do not use table rows.
    let parent = input?.parentElement;

    while (parent && parent !== document.body) {
      const text = (parent.textContent || '')
        .replace(/\s+/g, ' ')
        .trim();

      if (
        /SLO\s*\d+/i.test(text) &&
        parent.querySelector(INPUT_SEL)
      ) {
        return parent;
      }

      parent = parent.parentElement;
    }

    return null;
  }


  // Read the visible Learning Practice status for one SLO.
  function readSloStatus(input) {
    const row = findSloRow(input);

    if (!row) {
      return {
        status: 'unknown',
        row: null,
        label: ''
      };
    }

    const statusWords =
      /^(pending|resubmission|resubmit|submitted|approved|rejected|achieved)$/i;

    const candidates = [
      ...row.querySelectorAll(
        'span, div, label, strong, em, p, small'
      )
    ]
      .map((el) => ({
        el,
        text: (el.textContent || '')
          .replace(/\s+/g, ' ')
          .trim()
      }))
      .filter(({ el, text }) =>
        statusWords.test(text) && !el.children.length
      );

    // Prefer the exact status badge rather than a larger wrapper.
    const found = candidates.find(({ el }) =>
      el.classList.contains('ant-tag') ||
      el.className?.toString().toLowerCase().includes('status')
    ) || candidates[0];

    if (!found) {
      return {
        status: 'unknown',
        row,
        label: ''
      };
    }

    const label = found.text;
    const normalized = label.toLowerCase();

    if (normalized === 'pending') {
      return { status: 'pending', row, label };
    }

    if (
      normalized === 'resubmission' ||
      normalized === 'resubmit'
    ) {
      return { status: 'resubmission', row, label };
    }

    return {
      status: normalized,
      row,
      label
    };
  }


  // Find the UPDATE button belonging to this exact SLO input.
  function findSloUpdateButton(input) {
    const sloRow = findSloRow(input);
    let parent = input?.parentElement;

    while (parent && parent !== document.body) {
      const buttons = [
        ...parent.querySelectorAll('button, .ant-btn')
      ].filter((button) =>
        /\bupdate\b/i.test(button.textContent || '') &&
        button.offsetParent !== null
      );

      if (buttons.length) {
        return buttons[0];
      }

      if (parent === sloRow) break;

      parent = parent.parentElement;
    }

    return null;
  }


  // Wait until the portal visibly reports Pending for this SLO.
  async function waitForPending(input, timeoutMs = 12000) {
    const started = Date.now();

    while (
      Date.now() - started < timeoutMs &&
      !stopRequested
    ) {
      const state = readSloStatus(input);

      if (state.status === 'pending') {
        return {
          ok: true,
          ...state
        };
      }

      if (state.status === 'resubmission') {
        await sleep(250);
        continue;
      }

      await sleep(300);
    }

    return {
      ok: false,
      ...readSloStatus(input)
    };
  }


  // ============================================================
  // 16. SINGLE SESSION PROCESSOR
  // ============================================================

  async function processOpenSession(cur) {
    const inputs = await waitForAndExpandInputs(2, 4500);

    if (!inputs.length) {
      say(
        `⚠️ No link boxes found on U${cur.unit} S${cur.session} after expanding.`
      );

      return { ok: false };
    }

    const doClick = $('#lf-click').checked;
    const doTOTP = $('#lf-autototp').checked;

    if (doClick && doTOTP && !totpSecret) {
      say(
        '⚠️ TOTP is enabled but no secret is configured. Open ⚙️ and enter it, or disable auto TOTP.'
      );

      return { ok: false };
    }

    let done = 0;

    const skipped = [];
    const missing = [];

    for (let i = 0; i < inputs.length; i++) {
      if (stopRequested) {
        return { ok: false };
      }

      const initialInput = inputs[i];
      const n = sloOf(initialInput);

      if (!n) {
        say(
          `⚠️ Could not identify SLO number on U${cur.unit} S${cur.session}. Stopping.`
        );

        return { ok: false };
      }

      await waitForAndExpandInputs(2, 1800);

      const liveInput =
        document.getElementById(`studentPractice${n}Link`) ||
        initialInput;

      const initialStatus = readSloStatus(liveInput);

      // Pending is the only completed state.
      // Resubmission must be submitted again.
      if (
        doClick &&
        initialStatus.status === 'pending'
      ) {
        skipped.push(n);
        continue;
      }

      const link = (
        GM_getValue(key(cur.unit, cur.session, n), '') || ''
      ).trim();

      if (!isDrive(link)) {
        missing.push(n);
        continue;
      }

      setReactValue(liveInput, link);

      say(
        `📝 [U${cur.unit} S${cur.session}] Filled SLO ${n} link`
      );

      await sleep(100);

      if (!doClick) {
        done++;
        continue;
      }

      const btn = findSloUpdateButton(liveInput);

      if (!btn) {
        say(
          `⚠️ UPDATE button not found for SLO ${n} on U${cur.unit} S${cur.session}. Stopping.`
        );

        return { ok: false };
      }

      for (
        let w = 0;
        w < 30 && btn.disabled;
        w++
      ) {
        await sleep(50);
      }

      if (btn.disabled) {
        say(
          `⚠️ UPDATE stayed disabled for SLO ${n}. Check the link.`
        );

        return { ok: false };
      }

      let reachedPending = false;

      for (
        let attempt = 1;
        attempt <= 2 && !reachedPending;
        attempt++
      ) {
        if (stopRequested) {
          return { ok: false };
        }

        say(
          `🚀 [U${cur.unit} S${cur.session}] UPDATE SLO ${n} (attempt ${attempt}/2)...`
        );

        btn.click();

        if (doTOTP) {
          const verified = await waitForAndFillOTP(15000);

          if (!verified) {
            say(
              `⚠️ OTP verification failed on U${cur.unit} S${cur.session} SLO ${n}. Stopping.`
            );

            return { ok: false };
          }
        }

        // Wait for the portal's visible status to become Pending.
        const statusResult = await waitForPending(
          liveInput,
          12000
        );

        if (statusResult.ok) {
          reachedPending = true;

          say(
            `✅ U${cur.unit} S${cur.session} SLO ${n}: Pending confirmed.`
          );

          break;
        }

        if (
          statusResult.status === 'resubmission' &&
          attempt === 1
        ) {
          say(
            `↻ SLO ${n} still shows Resubmission. Retrying UPDATE once...`
          );

          await waitForAndExpandInputs(2, 1800);

          const refreshedInput =
            document.getElementById(
              `studentPractice${n}Link`
            ) || liveInput;

          const refreshedButton =
            findSloUpdateButton(refreshedInput);

          if (!refreshedButton) {
            say(
              `⚠️ Could not reacquire UPDATE for SLO ${n}. Stopping.`
            );

            return { ok: false };
          }

          if (refreshedInput.value !== link) {
            setReactValue(refreshedInput, link);
          }

          if (refreshedButton.disabled) {
            say(
              `⚠️ UPDATE is disabled on retry for SLO ${n}. Stopping.`
            );

            return { ok: false };
          }

          refreshedButton.click();

          if (doTOTP) {
            const verified = await waitForAndFillOTP(15000);

            if (!verified) {
              say(
                `⚠️ OTP verification failed on retry for SLO ${n}. Stopping.`
              );

              return { ok: false };
            }
          }

          const retryStatus = await waitForPending(
            refreshedInput,
            12000
          );

          if (retryStatus.ok) {
            reachedPending = true;

            say(
              `✅ U${cur.unit} S${cur.session} SLO ${n}: Pending confirmed.`
            );
          }

          break;

        } else {
          say(
            `❌ U${cur.unit} S${cur.session} SLO ${n} did not reach Pending (status: ${statusResult.label || statusResult.status}). Stopping so it is not silently skipped.`
          );

          return { ok: false };
        }
      }

      if (!reachedPending) {
        const finalStatus = readSloStatus(liveInput);

        say(
          `❌ U${cur.unit} S${cur.session} SLO ${n} still not Pending (status: ${finalStatus.label || finalStatus.status}). Stopping.`
        );

        return { ok: false };
      }

      done++;

      // Short pause lets the portal settle before the next SLO.
      await sleep(180);
    }

    say(
      `✅ U${cur.unit} S${cur.session}: ${done} ${doClick ? 'confirmed Pending' : 'filled'}` +
      (
        skipped.length
          ? `; SLO ${skipped.join(',')} already Pending`
          : ''
      ) +
      (
        missing.length
          ? `; SLO ${missing.join(',')} had no stored link`
          : ''
      )
    );

    return {
      ok: true,
      done,
      skipped,
      missing
    };
  }


  // ============================================================
  // 17. MAIN AUTO-CHAIN EXECUTION LOOP
  // ============================================================

  async function run() {
    if (busy) return;

    busy = true;
    stopRequested = false;

    $('#lf-stop').style.display = 'block';
    $('#lf-run-label').textContent = 'Running...';

    try {
      let cur = currentSession();

      // If no session is open, start from the selected target unit.
      if (!cur) {
        const first = findNextTargetSession(
          targetUnit,
          0,
          false
        );

        if (first) {
          const opened = await navigateToSessionViaWheel(
            first.unit,
            first.session
          );

          if (opened) {
            cur = currentSession();
          }
        }

        if (!cur) {
          say(
            '⚠️ Click "1" of any session on the wheel first.'
          );

          return;
        }
      }

      while (!stopRequested) {
        // Keep the link-review tab synchronized with the active unit.
        if (cur.unit !== viewUnit) {
          viewUnit = cur.unit;

          GM_setValue('viewUnit', viewUnit);

          renderTabs();
          renderFields();
        }

        const result = await processOpenSession(cur);

        if (!result.ok || stopRequested) {
          break;
        }

        const doAutoNext =
          $('#lf-autonext').checked;

        const doCrossUnit =
          $('#lf-crossunit').checked;

        if (!doAutoNext) {
          break;
        }

        const nextTarget = findNextTargetSession(
          cur.unit,
          cur.session,
          doCrossUnit
        );

        if (!nextTarget) {
          say(
            doCrossUnit
              ? `🎉 Finished! No more stored links found from Unit ${cur.unit} through Unit 5.`
              : `🎉 Unit ${cur.unit} finished. Enable cross-unit chaining to continue into later units.`
          );

          break;
        }

        await sleep(300);

        const switched = await navigateToSessionViaWheel(
          nextTarget.unit,
          nextTarget.session
        );

        if (!switched) {
          break;
        }

        cur = currentSession();

        // Verify the wheel actually opened the requested session.
        if (
          !cur ||
          cur.unit !== nextTarget.unit ||
          cur.session !== nextTarget.session
        ) {
          say(
            '⚠️ Session switch verification failed. Stopping chain.'
          );

          break;
        }
      }

    } catch (err) {
      say('❌ Error: ' + err.message);

    } finally {
      busy = false;
      stopRequested = false;

      $('#lf-stop').style.display = 'none';
      $('#lf-run-label').textContent = 'Start Auto-Chain';
    }
  }


  $('#lf-run').onclick = run;


  // ============================================================
  // 18. SESSION MONITOR
  // ============================================================

  let lastSig = null;

  setInterval(async () => {
    const current = currentSession();

    const curEl = $('#lf-cur');

    if (current) {
      if (curEl) {
        curEl.textContent =
          `📍 Open now: Unit ${current.unit}, Session ${current.session}`;
      }

    } else if (curEl) {
      curEl.textContent =
        '📍 Click "1" of any session on the wheel';
    }

    const sig = current
      ? `${current.unit}-${current.session}`
      : null;

    if (!sig || sig === lastSig) {
      return;
    }

    lastSig = sig;

    if (!busy && current.unit !== viewUnit) {
      viewUnit = current.unit;

      GM_setValue('viewUnit', viewUnit);

      renderTabs();
      renderFields();
    }

    if (!busy && $('#lf-auto').checked) {
      await sleep(500);

      await run();
    }

  }, 1000);


